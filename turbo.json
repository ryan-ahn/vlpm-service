{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": [
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
